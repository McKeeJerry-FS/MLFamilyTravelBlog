@page
@using MLFamilyTravelBlog.Models.Enums
@using MLFamilyTravelBlog.Services.Interfaces
@inject IImageService _ImageService
@model ProfileModel
@{
    ViewData["Title"] = "Author Profile";
    ViewData["ActivePage"] = ManageNavPages.Profile;
}

<h3>@ViewData["Title"]</h3>
<partial name="_StatusMessage" for="StatusMessage" />

<p class="text-muted">Update your author profile information. This will be displayed when you create blog posts.</p>

<div class="row">
    <div class="col-md-8">
        <form id="profile-form" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            
            <h5 class="mt-3">Personal Information</h5>
            <hr />
            
            <div class="row">
                <div class="col-md-6">
                    <div class="form-floating mb-3">
                        <input asp-for="Input.FirstName" class="form-control" autocomplete="given-name" aria-required="true" placeholder="First Name" />
                        <label asp-for="Input.FirstName" class="form-label"></label>
                        <span asp-validation-for="Input.FirstName" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-floating mb-3">
                        <input asp-for="Input.LastName" class="form-control" autocomplete="family-name" aria-required="true" placeholder="Last Name" />
                        <label asp-for="Input.LastName" class="form-label"></label>
                        <span asp-validation-for="Input.LastName" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Input.JobTitle" class="form-control" placeholder="Job Title" />
                <label asp-for="Input.JobTitle" class="form-label"></label>
                <span asp-validation-for="Input.JobTitle" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Bio" class="form-label"></label>
                <textarea asp-for="Input.Bio" class="form-control" rows="5" placeholder="Tell your readers about yourself..."></textarea>
                <span asp-validation-for="Input.Bio" class="text-danger"></span>
                <div class="form-text">This bio will be displayed in the author section of your blog posts.</div>
            </div>

            <h5 class="mt-4">Profile Image</h5>
            <hr />
            
            <div class="mb-3">
                <div class="text-center mb-3">
                    <img id="profileImagePreview" 
                         src="@Model.CurrentImageUrl" 
                         alt="Profile Image" 
                         class="img-thumbnail" 
                         style="max-width: 200px; max-height: 200px; border-radius: 50%;" />
                </div>
                <input asp-for="Input.ProfileImage" 
                       type="file" 
                       class="form-control" 
                       accept=".png,.jpg,.jpeg,.gif"
                       onchange="previewImage(this)" />
                <span asp-validation-for="Input.ProfileImage" class="text-danger"></span>
                <div class="form-text">Upload a profile picture (recommended: square image, at least 200x200px)</div>
            </div>

            <h5 class="mt-4">Social Media Links</h5>
            <hr />

            <div class="form-floating mb-3">
                <input asp-for="Input.FacebookUrl" class="form-control" placeholder="Facebook URL" />
                <label asp-for="Input.FacebookUrl" class="form-label"></label>
                <span asp-validation-for="Input.FacebookUrl" class="text-danger"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Input.InstagramUrl" class="form-control" placeholder="Instagram URL" />
                <label asp-for="Input.InstagramUrl" class="form-label"></label>
                <span asp-validation-for="Input.InstagramUrl" class="text-danger"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Input.TwitterUrl" class="form-control" placeholder="Twitter URL" />
                <label asp-for="Input.TwitterUrl" class="form-label"></label>
                <span asp-validation-for="Input.TwitterUrl" class="text-danger"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Input.LinkedInUrl" class="form-control" placeholder="LinkedIn URL" />
                <label asp-for="Input.LinkedInUrl" class="form-label"></label>
                <span asp-validation-for="Input.LinkedInUrl" class="text-danger"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Input.GitHubUrl" class="form-control" placeholder="GitHub URL" />
                <label asp-for="Input.GitHubUrl" class="form-label"></label>
                <span asp-validation-for="Input.GitHubUrl" class="text-danger"></span>
            </div>

            <button id="update-profile-button" type="submit" class="w-100 btn btn-lg btn-primary mt-3">Update Profile</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function previewImage(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('profileImagePreview').src = e.target.result;
                };
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}