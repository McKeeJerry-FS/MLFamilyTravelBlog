@model BlogUser

<style>
    .contact-page-wrapper {
        padding: 60px 0;
    }

    .page-header {
        text-align: center;
        margin-bottom: 60px;
    }

    .page-header h1 {
        font-size: 3rem;
        font-weight: 800;
        color: #512BD4;
        margin-bottom: 20px;
        letter-spacing: -1px;
    }

    .page-header p {
        font-size: 1.2rem;
        color: #6c757d;
        max-width: 700px;
        margin: 0 auto;
        line-height: 1.6;
    }

    .contact-content {
        max-width: 900px;
        margin: 0 auto;
    }

    .welcome-card {
        background: linear-gradient(135deg, #faf8fe 0%, #f9f7fd 100%);
        border-radius: 20px;
        padding: 40px;
        margin-bottom: 40px;
        box-shadow: 0 4px 20px rgba(81, 43, 212, 0.08);
        border: 1px solid rgba(81, 43, 212, 0.1);
    }

    .welcome-card h2 {
        font-size: 2rem;
        font-weight: 700;
        color: #512BD4;
        margin-bottom: 25px;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .welcome-card h2 i {
        font-size: 1.8rem;
    }

    .welcome-card p {
        font-size: 1.05rem;
        line-height: 1.8;
        color: #495057;
        margin-bottom: 20px;
    }

    .welcome-card p:last-of-type {
        margin-bottom: 0;
    }

    .email-info {
        background: linear-gradient(135deg, #512BD4 0%, #6941C6 100%);
        color: white;
        padding: 20px 28px;
        border-radius: 12px;
        display: inline-flex;
        align-items: center;
        gap: 12px;
        margin-top: 10px;
        box-shadow: 0 4px 16px rgba(81, 43, 212, 0.25);
    }

    .email-info i {
        font-size: 1.3rem;
    }

    .email-info a {
        color: white;
        text-decoration: none;
        font-weight: 600;
        font-size: 1.1rem;
        transition: all 0.3s ease;
    }

    .email-info a:hover {
        color: #e0e0e0;
        text-decoration: underline;
    }

    .contact-form-card {
        background: linear-gradient(135deg, #faf8fe 0%, #f9f7fd 100%);
        border-radius: 20px;
        padding: 45px;
        box-shadow: 0 4px 20px rgba(81, 43, 212, 0.08);
        border: 1px solid rgba(81, 43, 212, 0.1);
    }

    .form-header {
        margin-bottom: 35px;
    }

    .form-header h4 {
        font-size: 1.8rem;
        font-weight: 700;
        color: #512BD4;
        margin-bottom: 12px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .form-header h4 i {
        font-size: 1.6rem;
    }

    .form-header p {
        color: #6c757d;
        font-size: 1rem;
        margin-bottom: 0;
    }

    .modern-form-group {
        margin-bottom: 28px;
    }

    .modern-form-label {
        font-weight: 600;
        color: #2c2c2c;
        margin-bottom: 10px;
        display: block;
        font-size: 0.95rem;
    }

    .modern-form-label i {
        color: #512BD4;
        margin-right: 6px;
    }

    .modern-form-control {
        border: 2px solid #e0e0e0;
        border-radius: 12px;
        padding: 14px 18px;
        font-size: 1rem;
        transition: all 0.3s ease;
        background: linear-gradient(135deg, #fdfcff 0%, #faf8fe 100%);
        width: 100%;
    }

    .modern-form-control:focus {
        border-color: #512BD4;
        box-shadow: 0 0 0 4px rgba(81, 43, 212, 0.1);
        background: linear-gradient(135deg, #ffffff 0%, #fdfcff 100%);
        outline: none;
    }

    .modern-textarea {
        min-height: 200px;
        resize: vertical;
    }

    .btn-modern-submit {
        background: linear-gradient(135deg, #512BD4 0%, #6941C6 100%);
        color: white;
        padding: 16px 48px;
        border-radius: 12px;
        font-weight: 600;
        font-size: 1.1rem;
        border: none;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        cursor: pointer;
    }

    .btn-modern-submit:hover {
        background: linear-gradient(135deg, #4521b5 0%, #5832a8 100%);
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(81, 43, 212, 0.4);
        color: white;
    }

    .form-submit {
        display: flex;
        justify-content: center;
        margin-top: 35px;
    }

    @@media (max-width: 768px) {
        .page-header h1 {
            font-size: 2.2rem;
        }

        .welcome-card, .contact-form-card {
            padding: 30px 20px;
        }

        .email-info {
            flex-direction: column;
            text-align: center;
        }
    }
</style>

<div class="contact-page-wrapper">
    <div class="container">
        <div class="page-header">
            <h1><i class="fas fa-envelope-open-text"></i> Contact Me</h1>
            <p>Thank you so much for your support! Drop me a line to let me know your experience here on the McKee Family Travel Blog!</p>
        </div>

        <div class="contact-content">
            <div class="welcome-card">
                <h2><i class="fas fa-hand-wave"></i> Say Hello!</h2>
                <p>Thank you so much for supporting the blog just by viewing the posts and dropping a comment or two on the blogs.</p>
                <p>If you are interested in collaborating on a project, getting more insight into a particular post that may have caught your interest, or just have general questions for me, please use the form below to send me an email. Emails are checked multiple times per day so I will get back to you. I am looking forward to communicating with you or collaborating on any future projects. Have a great day and if you are a fellow developer, Happy Coding!</p>
                <div class="email-info">
                    <i class="fas fa-envelope"></i>
                    <a href="mailto:jerry.mckee.jr@gmail.com">jerry.mckee.jr@gmail.com</a>
                </div>
            </div>

            <div class="contact-form-card">
                <div class="form-header">
                    <h4><i class="fas fa-paper-plane"></i> Send Me a Message</h4>
                    <p>Your email address will not be published. All fields are required.</p>
                </div>

                <form method="post" asp-action="ContactMe">
                    <div class="row">
                        <div class="col-lg-6 col-md-6 col-12">
                            <div class="modern-form-group">
                                <label class="modern-form-label">
                                    <i class="fas fa-user"></i> First Name
                                </label>
                                <input asp-for="FirstName" class="form-control modern-form-control" placeholder="Enter your first name..." />
                            </div>
                        </div>
                        <div class="col-lg-6 col-md-6 col-12">
                            <div class="modern-form-group">
                                <label class="modern-form-label">
                                    <i class="fas fa-user"></i> Last Name
                                </label>
                                <input asp-for="LastName" class="form-control modern-form-control" placeholder="Enter your last name..." />
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="modern-form-group">
                                <label class="modern-form-label">
                                    <i class="fas fa-envelope"></i> Email
                                </label>
                                <input asp-for="Email" class="form-control modern-form-control" placeholder="your.email@example.com" />
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="modern-form-group">
                                <label class="modern-form-label">
                                    <i class="fas fa-comment-dots"></i> Message
                                </label>
                                <textarea id="editor" name="message" class="form-control modern-form-control modern-textarea" placeholder="Write your message here..."></textarea>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="form-submit">
                                <button type="submit" class="btn-modern-submit">
                                    <i class="fas fa-paper-plane"></i> Send Message
                                </button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@section scripts {

    <!--Sweet Alerts-->
    <script src="//cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        let message = '@(ViewBag.SwalMessage)';
        if (!message.includes("Error") && message != '') {
            Swal.fire({
                backdrop: false,
                icon: 'success',
                title: message,
                showConfirmButton: true
            });
        } else if (message.includes("Error")) {
            Swal.fire({
                backdrop: false,
                icon: 'error',
                title: 'Oops...',
                text: message
            });
        }
    </script>
    <!--End Sweet Alerts-->
    <!--CK Editor-->
    <script src="https://cdn.ckeditor.com/ckeditor5/37.1.0/classic/ckeditor.js"></script>

    <script>
        ClassicEditor
            .create(document.querySelector('.editor'), {
                licenseKey: '',
            })
            .then(editor => {
                window.editor = editor;
            });
    </script>
    <!--End CK Editor-->
}o