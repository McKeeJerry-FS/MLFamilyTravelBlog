@model IEnumerable<MLFamilyTravelBlog.Models.BlogPost>

@{
    ViewData["Title"] = "Archived";
}

<h1>Archived Blog Posts</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus"></i> Create New
    </a>
</p>

@if (!Model.Any())
{
    <div class="alert alert-info">
        <i class="fas fa-info-circle"></i> No archived blog posts found.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>@Html.DisplayNameFor(model => model.Title)</th>
                    <th>@Html.DisplayNameFor(model => model.Abstract)</th>
                    <th>@Html.DisplayNameFor(model => model.Created)</th>
                    <th>@Html.DisplayNameFor(model => model.Updated)</th>
                    <th>@Html.DisplayNameFor(model => model.IsArchived)</th>
                    <th>@Html.DisplayNameFor(model => model.IsPublished)</th>
                    <th>Comments</th>
                    <th>@Html.DisplayNameFor(model => model.Category)</th>
                    <th>@Html.DisplayNameFor(model => model.Tags)</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.Title)</td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.Abstract))
                            {
                                @(item.Abstract.Length > 100 ? item.Abstract.Substring(0, 100) + "..." : item.Abstract)
                            }
                        </td>
                        <td>@item.Created.LocalDateTime.ToString("g")</td>
                        <td>@(item.Updated.HasValue ? item.Updated.Value.LocalDateTime.ToString("g") : "N/A")</td>
                        <td>
                            @if (item.IsArchived)
                            {
                                <span class="badge bg-warning">Archived</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Active</span>
                            }
                        </td>
                        <td>
                            @if (item.IsPublished)
                            {
                                <span class="badge bg-success">Published</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Draft</span>
                            }
                        </td>
                        <td>@item.Comments.Count</td>
                        <td>@Html.DisplayFor(modelItem => item.Category!.Name)</td>
                        <td>
                            @foreach (Tag tag in item.Tags)
                            {
                                <span class="badge rounded-pill bg-primary me-1">@tag.Name</span>
                            }
                        </td>
                        <td class="text-nowrap">
                            <div class="btn-group" role="group">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning" title="Edit">
                                    <i class="fas fa-edit"></i>
                                </a>
                                @* Details uses slug, not id *@
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info" title="View Details">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger" title="Delete">
                                    <i class="fas fa-trash"></i>
                                </a>
                                @* Add Unarchive button *@
                                @if (item.IsArchived)
                                {
                                    <a asp-action="Unarchive" asp-route-id="@item.Id" class="btn btn-sm btn-success" title="Unarchive">
                                        <i class="fas fa-undo"></i>
                                    </a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">
        <i class="fas fa-arrow-left"></i> Back to List
    </a>
</div>