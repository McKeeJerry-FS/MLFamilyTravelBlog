@model MLFamilyTravelBlog.Models.Tag

<style>
    .modern-form-container {
        max-width: 600px;
        margin: 0 auto;
        padding: 40px 20px;
    }

    .page-header {
        margin-bottom: 40px;
        text-align: center;
    }

    .page-header h1 {
        font-size: 2.5rem;
        font-weight: 800;
        color: #512BD4;
        margin-bottom: 12px;
        letter-spacing: -0.5px;
    }

    .page-header p {
        font-size: 1.1rem;
        color: #6c757d;
    }

    .form-card {
        background: linear-gradient(135deg, #faf8fe 0%, #f9f7fd 100%);
        border-radius: 20px;
        padding: 40px;
        box-shadow: 0 4px 20px rgba(81, 43, 212, 0.08);
        border: 1px solid rgba(81, 43, 212, 0.1);
        margin-bottom: 30px;
    }

    .modern-form-group {
        margin-bottom: 28px;
    }

    .modern-form-label {
        font-weight: 600;
        color: #2c2c2c;
        margin-bottom: 10px;
        display: block;
        font-size: 0.95rem;
    }

    .modern-form-label i {
        color: #512BD4;
        margin-right: 6px;
    }

    .modern-form-control {
        border: 2px solid #e0e0e0;
        border-radius: 12px;
        padding: 14px 18px;
        font-size: 1rem;
        transition: all 0.3s ease;
        background: linear-gradient(135deg, #fdfcff 0%, #faf8fe 100%);
        width: 100%;
    }

    .modern-form-control:focus {
        border-color: #512BD4;
        box-shadow: 0 0 0 4px rgba(81, 43, 212, 0.1);
        background: linear-gradient(135deg, #ffffff 0%, #fdfcff 100%);
        outline: none;
    }

    .action-buttons {
        display: flex;
        gap: 15px;
        justify-content: space-between;
        margin-top: 30px;
    }

    .btn-modern {
        padding: 14px 32px;
        border-radius: 12px;
        font-weight: 600;
        font-size: 1.05rem;
        transition: all 0.3s ease;
        border: none;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
    }

    .btn-modern-cancel {
        background: linear-gradient(135deg, #fdfcff 0%, #faf8fe 100%);
        color: #6c757d;
        border: 2px solid rgba(81, 43, 212, 0.2);
    }

    .btn-modern-cancel:hover {
        background: linear-gradient(135deg, #f9f7fd 0%, #f5f2fb 100%);
        color: #495057;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(81, 43, 212, 0.15);
    }

    .btn-modern-submit {
        background: linear-gradient(135deg, #512BD4 0%, #6941C6 100%);
        color: white;
        padding: 16px 40px;
    }

    .btn-modern-submit:hover {
        background: linear-gradient(135deg, #4521b5 0%, #5832a8 100%);
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(81, 43, 212, 0.4);
    }
</style>

@{
    ViewData["Title"] = "Edit Tag";
}

<div class="post-single-wrapper axil-section-gap bg-color-white">
    <div class="modern-form-container">
        <div class="page-header">
            <h1><i class="fas fa-edit"></i> Edit Tag</h1>
            <p>Update tag information</p>
        </div>

        <div class="form-card">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="Id" />
                
                <div class="modern-form-group">
                    <label asp-for="Name" class="modern-form-label">
                        <i class="fas fa-tag"></i> Tag Name
                    </label>
                    <input asp-for="Name" class="form-control modern-form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                
                <div class="action-buttons">
                    <a asp-action="Index" class="btn-modern btn-modern-cancel">
                        <i class="fas fa-times"></i> Cancel
                    </a>
                    <button type="submit" class="btn-modern btn-modern-submit">
                        <i class="fas fa-save"></i> Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
