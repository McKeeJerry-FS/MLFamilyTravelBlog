@inject IImageService _ImageService
@inject UserManager<BlogUser> _userManager
@inject ApplicationDbContext _context
@using MLFamilyTravelBlog.Data
@{
    BlogUser? blogUser = await _userManager.GetUserAsync(User);
    bool isSubscribed = false;
    if (blogUser != null && !string.IsNullOrEmpty(blogUser.Email))
    {
        isSubscribed = _context.Subscribers.Any(s => s.Email == blogUser.Email);
    }
}

<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MLFamilyTravelBlog</title>
    <script type="importmap"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="~/MLFamilyTravelBlog.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/assets/css/vendor/font-awesome.css">
    <link rel="stylesheet" href="~/assets/css/vendor/slick.css">
    <link rel="stylesheet" href="~/assets/css/vendor/slick-theme.css">
    <link rel="stylesheet" href="~/assets/css/vendor/base.css">
    <link rel="stylesheet" href="~/assets/css/plugins/plugins.css">
    <link rel="stylesheet" href="~/assets/css/style.css">
    <link rel="stylesheet" href="~/css/site.css">

    <style>
        /* True Dark Mode Styles */
        :root {
            /* Light Mode Colors */
            --bg-primary: linear-gradient(135deg, #f5f2fb 0%, #f7f4fc 50%, #f9f6fd 100%);
            --bg-secondary: #ffffff;
            --bg-card: #ffffff;
            --text-primary: #212529;
            --text-secondary: #6c757d;
            --text-muted: #adb5bd;
            --border-color: #e9ecef;
            --shadow: rgba(0, 0, 0, 0.08);
            --shadow-hover: rgba(102, 126, 234, 0.2);
            --gradient-primary: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            --gradient-card: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        }

        [data-theme="dark"] {
            /* Dark Mode Colors */
            --bg-primary: linear-gradient(135deg, #0f0f1e 0%, #1a1a2e 50%, #0f0f1e 100%);
            --bg-secondary: #1a1a2e;
            --bg-card: #252541;
            --text-primary: #e9ecef;
            --text-secondary: #adb5bd;
            --text-muted: #6c757d;
            --border-color: #3a3a4e;
            --shadow: rgba(0, 0, 0, 0.3);
            --shadow-hover: rgba(102, 126, 234, 0.4);
            --gradient-primary: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            --gradient-card: linear-gradient(135deg, #2a2a3e 0%, #323252 100%);
        }

        /* Apply dark mode to body and main elements */
        body {
            background: var(--bg-primary) !important;
            background-attachment: fixed !important;
            color: var(--text-primary);
            transition: background 0.3s ease, color 0.3s ease;
        }

        [data-theme="dark"] body {
            background: linear-gradient(135deg, #0f0f1e 0%, #1a1a2e 50%, #0f0f1e 100%) !important;
        }

        .main-wrapper {
            background: transparent !important;
        }

        /* Cards and containers - IMPORTANT: Override inline styles */
        [data-theme="dark"] .bg-color-white,
        [data-theme="dark"] .axil-post-list-area,
        [data-theme="dark"] .modern-blog-card,
        [data-theme="dark"] .tag-card,
        [data-theme="dark"] .category-card,
        [data-theme="dark"] .admin-actions-card,
        [data-theme="dark"] .content-block,
        [data-theme="dark"] .card {
            background: #252541 !important;
            color: var(--text-primary);
            border-color: #3a3a4e !important;
        }

        /* Override inline background styles on cards */
        [data-theme="dark"] .card[style*="background"],
        [data-theme="dark"] div[style*="background: linear-gradient(135deg, #f8f9fa"] {
            background: linear-gradient(135deg, #2a2a3e 0%, #323252 100%) !important;
        }

        /* Specific override for stats cards and overview cards */
        [data-theme="dark"] .card-body,
        [data-theme="dark"] .overview-stat,
        [data-theme="dark"] .category-stats {
            background: linear-gradient(135deg, #2a2a3e 0%, #323252 100%) !important;
        }

        /* Container backgrounds */
        [data-theme="dark"] .container,
        [data-theme="dark"] .post-single-wrapper,
        [data-theme="dark"] .axil-section-gap {
            background: #1a1a2e !important;
        }

        /* Text colors - force override */
        [data-theme="dark"] h1,
        [data-theme="dark"] h2,
        [data-theme="dark"] h3,
        [data-theme="dark"] h4,
        [data-theme="dark"] h5,
        [data-theme="dark"] h6,
        [data-theme="dark"] .h1,
        [data-theme="dark"] .h2,
        [data-theme="dark"] .h3,
        [data-theme="dark"] .h4,
        [data-theme="dark"] .h5,
        [data-theme="dark"] .h6 {
            color: #e9ecef !important;
        }

        [data-theme="dark"] .card-title a,
        [data-theme="dark"] .category-name,
        [data-theme="dark"] .tag-name,
        [data-theme="dark"] p,
        [data-theme="dark"] span,
        [data-theme="dark"] .title {
            color: #e9ecef !important;
        }

        [data-theme="dark"] .text-muted,
        [data-theme="dark"] .category-description,
        [data-theme="dark"] .text-secondary {
            color: #adb5bd !important;
        }

        /* Quick Actions title - override inline color */
        [data-theme="dark"] h5[style*="color: #495057"] {
            color: #e9ecef !important;
        }

        /* Header and Navigation */
        [data-theme="dark"] .header,
        [data-theme="dark"] .header-light,
        [data-theme="dark"] .bg-secondary {
            background: #252541 !important;
            border-bottom: 1px solid #3a3a4e;
        }

        [data-theme="dark"] .mainmenu a,
        [data-theme="dark"] .text-dark,
        [data-theme="dark"] .mainmenu .text-dark {
            color: #e9ecef !important;
        }

        [data-theme="dark"] .axil-submenu {
            background: #252541 !important;
            border: 1px solid #3a3a4e;
        }

        [data-theme="dark"] .axil-submenu a {
            color: #e9ecef !important;
        }

        /* Footer */
        [data-theme="dark"] .axil-footer-area {
            background: #252541 !important;
            color: #e9ecef;
        }

        [data-theme="dark"] footer {
            background: #252541 !important;
            color: #e9ecef !important;
            border-top-color: #3a3a4e !important;
        }

        /* Shadows */
        [data-theme="dark"] .modern-blog-card,
        [data-theme="dark"] .tag-card,
        [data-theme="dark"] .category-card,
        [data-theme="dark"] .admin-actions-card,
        [data-theme="dark"] .card {
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3) !important;
        }

        [data-theme="dark"] .modern-blog-card:hover,
        [data-theme="dark"] .tag-card:hover,
        [data-theme="dark"] .category-card:hover {
            box-shadow: 0 12px 32px rgba(102, 126, 234, 0.4) !important;
        }

        /* Stats number colors */
        [data-theme="dark"] .overview-stat-number {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;
            -webkit-background-clip: text !important;
            -webkit-text-fill-color: transparent !important;
            background-clip: text !important;
        }

        [data-theme="dark"] .category-stat-number {
            color: #667eea !important;
        }

        [data-theme="dark"] .fw-bold.text-primary,
        [data-theme="dark"] .text-primary {
            color: #667eea !important;
        }

        [data-theme="dark"] .fw-bold.text-success,
        [data-theme="dark"] .text-success {
            color: #20c997 !important;
        }

        [data-theme="dark"] .fw-bold.text-warning,
        [data-theme="dark"] .text-warning {
            color: #ffc107 !important;
        }

        /* Forms and Inputs */
        [data-theme="dark"] .form-control,
        [data-theme="dark"] input,
        [data-theme="dark"] textarea,
        [data-theme="dark"] select {
            background: #252541 !important;
            color: #e9ecef !important;
            border-color: #3a3a4e !important;
        }

        [data-theme="dark"] .form-control:focus,
        [data-theme="dark"] input:focus,
        [data-theme="dark"] textarea:focus {
            background: #252541 !important;
            color: #e9ecef !important;
            border-color: #667eea !important;
        }

        [data-theme="dark"] .form-control::placeholder,
        [data-theme="dark"] input::placeholder,
        [data-theme="dark"] textarea::placeholder {
            color: #6c757d !important;
        }

        /* Dropdown menus */
        [data-theme="dark"] .dropdown-menu {
            background: #252541 !important;
            border-color: #3a3a4e !important;
        }

        [data-theme="dark"] .dropdown-item {
            color: #e9ecef !important;
        }

        [data-theme="dark"] .dropdown-item p {
            color: #e9ecef !important;
        }

        [data-theme="dark"] .dropdown-item:hover {
            background: linear-gradient(135deg, #2a2a3e 0%, #323252 100%) !important;
        }

        /* Mobile menu */
        [data-theme="dark"] .popup-mobilemenu-area {
            background: #252541 !important;
        }

        [data-theme="dark"] .popup-mobilemenu-area .inner {
            background: #252541 !important;
        }

        [data-theme="dark"] .popup-mobilemenu-area .mainmenu li a {
            color: #e9ecef !important;
        }

        /* Theme Switcher */
        .theme-toggle-btn {
            position: fixed;
            top: 100px;
            right: 20px;
            z-index: 1000;
            background: var(--gradient-primary);
            border: none;
            color: white;
            width: 50px;
            height: 50px;
            border-radius: 50%;
            cursor: pointer;
            box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4);
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
        }

        .theme-toggle-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(102, 126, 234, 0.5);
        }

        /* Hide old theme switcher */
        #my_switcher {
            display: none;
        }

        /* Breadcrumb in dark mode */
        [data-theme="dark"] .breadcrumb-item a {
            color: rgba(255, 255, 255, 0.9) !important;
        }

        [data-theme="dark"] .breadcrumb-item.active {
            color: rgba(255, 255, 255, 0.5) !important;
        }

        [data-theme="dark"] .text-white-50 {
            color: rgba(255, 255, 255, 0.5) !important;
        }

        /* Post meta in dark mode */
        [data-theme="dark"] .post-meta-list li,
        [data-theme="dark"] .author-name,
        [data-theme="dark"] .post-meta {
            color: #adb5bd !important;
        }

        /* Search */
        [data-theme="dark"] .header-search-form .form-control {
            background: #252541 !important;
            border-color: #3a3a4e !important;
            color: #e9ecef !important;
        }

        /* Buttons - keep gradient buttons as is, but fix outline buttons */
        [data-theme="dark"] .btn-outline-success {
            color: #20c997 !important;
            border-color: #20c997 !important;
        }

        [data-theme="dark"] .btn-outline-success:hover {
            background: #20c997 !important;
            color: #fff !important;
        }

        [data-theme="dark"] .btn-outline-warning {
            color: #ffc107 !important;
            border-color: #ffc107 !important;
        }

        [data-theme="dark"] .btn-outline-warning:hover {
            background: #ffc107 !important;
            color: #000 !important;
        }

        [data-theme="dark"] .btn-outline-danger {
            color: #dc3545 !important;
            border-color: #dc3545 !important;
        }

        [data-theme="dark"] .btn-outline-danger:hover {
            background: #dc3545 !important;
            color: #fff !important;
        }

        [data-theme="dark"] .btn-outline-info {
            color: #17a2b8 !important;
            border-color: #17a2b8 !important;
        }

        [data-theme="dark"] .btn-outline-info:hover {
            background: #17a2b8 !important;
            color: #fff !important;
        }

        [data-theme="dark"] .btn-outline-primary {
            color: #667eea !important;
            border-color: #667eea !important;
        }

        [data-theme="dark"] .btn-outline-primary:hover {
            background: #667eea !important;
            color: #fff !important;
        }

        [data-theme="dark"] .btn-outline-secondary {
            color: #adb5bd !important;
            border-color: #adb5bd !important;
        }

        [data-theme="dark"] .btn-outline-secondary:hover {
            background: #adb5bd !important;
            color: #000 !important;
        }

        /* Category badges */
        [data-theme="dark"] .category-badge,
        [data-theme="dark"] .tag-badge {
            /* Keep gradient for badges */
            color: white !important;
        }

        /* Image wrappers - keep as is but ensure proper contrast */
        [data-theme="dark"] .category-image-wrapper,
        [data-theme="dark"] .card-image-wrapper {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;
        }

        /* Labels in stats */
        [data-theme="dark"] .overview-stat-label,
        [data-theme="dark"] .category-stat-label,
        [data-theme="dark"] .stats-label {
            color: #adb5bd !important;
        }

        /* Copyright and footer text */
        [data-theme="dark"] .copyright-area {
            background: #252541 !important;
            border-top: 1px solid #3a3a4e;
        }

        [data-theme="dark"] .copyright-area p,
        [data-theme="dark"] .copyright-area a {
            color: #adb5bd !important;
        }

        /* Pagination */
        [data-theme="dark"] .my-page-link {
            background: #252541 !important;
            color: #e9ecef !important;
            border-color: #3a3a4e !important;
        }

        [data-theme="dark"] .my-page-link:hover {
            background: #667eea !important;
            color: #fff !important;
        }
    </style>
</head>
<body>
    <partial name="_logoutPartial" />

    <!-- Modern Theme Toggle Button -->
    <button class="theme-toggle-btn" id="themeToggle" aria-label="Toggle Dark Mode">
        <i class="fas fa-moon" id="themeIcon"></i>
    </button>

    <div class="main-wrapper">
        <div class="mouse-cursor cursor-outer"></div>
        <div class="mouse-cursor cursor-inner"></div>

        <!-- Start Header -->
        <header class="header axil-header header-light header-sticky header-with-shadow bg-secondary">
            <div class="header-wrap">
                <div class="row justify-content-between align-items-center">
                    <div class="col-xl-3 col-lg-3 col-md-4 col-sm-3 col-12">
                        <div class="logo">
                            <a asp-controller="BlogPosts" asp-action="Index">
                                <p class="fs-2">ML Family Travel Blog</p>
                            </a>
                        </div>
                    </div>
                    <div class="col-xl-6 d-none d-xl-block">
                        <div class="mainmenu-wrapper">
                            <nav class="mainmenu-nav">
                                <!-- Start Mainmanu Nav -->
                                <ul class="mainmenu text-dark">
                                    <li class="menu-item-has-children">
                                        <a asp-controller="BlogPosts" asp-action="Index" class="text-dark">Home</a>
                                    </li>
                                    <li class="menu-item-has-children">
                                        <a href="#" class="text-dark">Posts</a>
                                        <ul class="axil-submenu">
                                            <li>
                                                <a class="hover-flip-item-wrapper" asp-action="Index" asp-controller="BlogPosts">
                                                    <span class="">
                                                        <span>All Posts</span>
                                                    </span>
                                                </a>
                                            </li>
                                            <li>
                                                <a class="hover-flip-item-wrapper" asp-action="Popular" asp-controller="BlogPosts">
                                                    <span class="">
                                                        <span> Popular Posts</span>
                                                    </span>
                                                </a>
                                            </li>
                                            @*<li>
                                            <a class="hover-flip-item-wrapper" asp-action="Recent" asp-controller="Home">
                                            <span class="">
                                            <span data-text="Recent Posts">Recent Posts</span>
                                            </span>
                                            </a>
                                            </li>*@
                                        </ul>
                                    </li>
                                    @if(User.Identity!.IsAuthenticated)
                                    {
                                        <li>
                                            <a class="hover-flip-item-wrapper" asp-action="Favorites" asp-controller="BlogPosts">
                                                <span class="">
                                                    <span class="text-dark"> Favorite Posts</span>
                                                </span>
                                            </a>
                                        </li>
                                    }
                                    <li><a asp-action="ContactMe" asp-controller="BlogPosts" class="text-dark">Contact Me</a></li>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li class="menu-item-has-children">
                                            <a href="#" class="text-dark">Author</a>
                                            <ul class="axil-submenu">
                                                <li>
                                                    <a class="hover-flip-item-wrapper" asp-controller="BlogPosts" asp-action="AuthorArea">
                                                        <span class="">
                                                            <span>Author Area</span>
                                                        </span>
                                                    </a>
                                                </li>
                                                <li>
                                                    <a class="hover-flip-item-wrapper" asp-controller="BlogPosts" asp-action="Index">
                                                        <span class="">
                                                            <span>Admin</span>
                                                        </span>
                                                    </a>
                                                </li>
                                                <li>
                                                    <a class="hover-flip-item-wrapper" href="~/swagger">
                                                        <span class="">
                                                            <span>APIs</span>
                                                        </span>
                                                    </a>
                                                </li>
                                                <li>
                                                    <a class="hover-flip-item-wrapper" asp-controller="BlogPosts" asp-action="Create">
                                                        <span class="">
                                                            <span>Add New Post</span>
                                                        </span>
                                                    </a>
                                                </li>
                                                <li>
                                                    <a class="hover-flip-item-wrapper" asp-controller="BlogPosts" asp-action="AuthorArea">
                                                        <span class="hover-flip-item">
                                                            <span data-text="Manage Posts">Manage Posts</span>
                                                        </span>
                                                    </a>
                                                </li>
                                                <li>
                                                    <a class="hover-flip-item-wrapper" asp-controller="Categories" asp-action="Index">
                                                        <span class="hover-flip-item">
                                                            <span data-text="Manage Categories">Manage Categories</span>
                                                        </span>
                                                    </a>
                                                </li>
                                                <li>
                                                    <a class="hover-flip-item-wrapper" asp-controller="Tags" asp-action="Index">
                                                        <span class="hover-flip-item">
                                                            <span data-text="Manage Tags">Manage Tags</span>
                                                        </span>
                                                    </a>
                                                </li>
                                                <li>
                                                    <a class="hover-flip-item-wrapper" asp-action="Draft" asp-controller="BlogPosts">
                                                        <span class="hover-flip-item">
                                                            <span data-text="Draft Posts">Draft Posts</span>
                                                        </span>
                                                    </a>
                                                </li>
                                                <li>
                                                    <a class="hover-flip-item-wrapper" asp-action="Archived" asp-controller="BlogPosts">
                                                        <span class="hover-flip-item">
                                                            <span data-text="Archieved">Archived Posts</span>
                                                        </span>
                                                    </a>
                                                </li>
                                                <li>
                                                    <a class="hover-flip-item-wrapper" asp-controller="Admin" asp-action="Users">
                                                        <span class="">
                                                            <span>Manage Users</span>
                                                        </span>
                                                    </a>
                                                </li>
                                                <li>
                                                    <a class="hover-flip-item-wrapper" asp-controller="Admin" asp-action="Subscribers">
                                                        <span class="">
                                                            <span>View Subscribers</span>
                                                        </span>
                                                    </a>
                                                </li>
                                            </ul>
                                        </li>
                                    }
                                </ul>
                                <!-- End Mainmanu Nav -->
                            </nav>
                        </div>
                    </div>
                    <div class="col-xl-3 col-lg-8 col-md-8 col-sm-9 col-12">
                        <div class="header-search text-end d-flex align-items-center">
                            <form asp-action="SearchIndex" asp-controller="BlogPosts" method="get" class="header-search-form d-sm-block d-none">
                                <div class="axil-search form-group">
                                    <button type="submit" class="search-button"><i class="fal fa-search"></i></button>
                                    <input type="text" class="form-control" placeholder="Search" name="searchString" value="@ViewBag.Search">
                                </div>
                            </form>
                            <div class="mobile-search-wrapper d-sm-none d-block">
                                <button class="search-button-toggle"><i class="fal fa-search"></i></button>
                                <form asp-action="" asp-controller="" class="header-search-form">
                                    <div class="axil-search form-group">
                                        <button type="submit" class="search-button"><i class="fal fa-search"></i></button>
                                        <input type="text" class="form-control" placeholder="Search" name="">
                                    </div>
                                </form>
                            </div>
                            <ul class="metabar-block">
                                <li class="nav-item dropdown has-arrow main-drop">
                                    <a href="#" class="dropdown-toggle nav-link" data-bs-toggle="dropdown" aria-expanded="false">
                                        @if (User.Identity!.IsAuthenticated)
                                        {
                                            <span class="user-img">
                                                <img src="@_ImageService.ConvertByteArrayToFile(null, null, DefaultImage.AuthorImage)" alt="User Image">
                                                <span class="status online"></span>
                                            </span>
                                            <span>@blogUser?.FullName</span>
                                        } else
                                        {
                                            <span class="user-img">
                                                <img src="@_ImageService.ConvertByteArrayToFile(null, null, DefaultImage.BlogUserImage)" alt="User Image">
                                                <span class="status online"></span>
                                            </span>
                                            <span>@blogUser?.FullName</span>
                                        }
                                    </a>
                                    @if (User.Identity!.IsAuthenticated)
                                    {
                                        <div class="dropdown-menu animate__slideInDown">
                                            <a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Index"><p style="color:black">My Profile</p></a>
                                            <a class="dropdown-item" href="javascript:document.getElementById('logoutForm').submit()"><p style="color:black">Logout</p></a>
                                            @if (!isSubscribed)
                                            {
                                                <a class="dropdown-item" asp-controller="Subscription" asp-action="Subscribe"><p style="color:black">Subscribe</p></a>
                                            }
                                            else
                                            {
                                                <a class="dropdown-item" asp-controller="Subscription" asp-action="Unsubscribe"><p style="color:black">Unsubscribe</p></a>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="dropdown-menu animate__slideInDown">
                                            <a class="dropdown-item" asp-area="Identity" asp-page="/Account/Login"><p style="color:black">Sign In</p></a>
                                            <a class="dropdown-item" asp-area="Identity" asp-page="/Account/Register"><p style="color:black">Register</p></a>
                                        </div>
                                    }
                                </li>
                            </ul>
                            <!-- Start Hamburger Menu  -->
                            <div class="hamburger-menu d-block d-xl-none">
                                <div class="hamburger-inner">
                                    <div class="icon"><i class="fal fa-bars"></i></div>
                                </div>
                            </div>
                            <!-- End Hamburger Menu  -->
                        </div>
                    </div>
                </div>
            </div>
        </header>
        <!-- Start Header -->
        <!-- Start Mobile Menu Area  -->
        <div class="popup-mobilemenu-area">
            <div class="inner">
                <div class="mobile-menu-top">
                    <div class="logo">
                        <a asp-controller="BlogPosts" asp-action="Index">
