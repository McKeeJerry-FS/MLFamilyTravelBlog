﻿@using MLFamilyTravelBlog.Services.Interfaces
@using MLFamilyTravelBlog.Models.Enums
@inject IImageService _ImageService


<!-- Start Author Area  -->
<div class="axil-author-area axil-author-banner bg-secondary" id="authorArea">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="about-author">
                    <div class="media">
                        <div class="thumbnail">
                            <a href="#">
                                <img src="@_ImageService.ConvertByteArrayToFile(null, null, DefaultImage.AuthorImage)" alt="Author Images" style="height:150px;width:150px">
                            </a>
                        </div>
                        <div class="media-body">
                            <div class="author-info">
                                <h1 class="title"><a href="#">Jay McKee Jr</a></h1>
                                <span class="b3 subtitle">Full Stack .NET Web Application Developer and avid traveler</span>
                            </div>
                            <div class="content">
                                <p class="b1 description">I have been traveling since I've graduated high school thanks to my time in culinary school, visiting places like Massachusetts, Florida, Utah, and Colorado, just to name a few places. Now with my family, I continue on the traditon of traveling to experience new things and places in the hopes to broaden my horizon and just enjoy life and the world around me.</p>
                                <p>It is my hope that in sharing these experiences, that I can inspire people to explore the world around them and create their own adventures.</p>
                                <blockquote class="b1 description">"Whether you think you can or you think you can't, you're right!" -Anonymous</blockquote>
                                
                                <ul class="social-share-transparent size-md">
                                    <li><a href="https://www.instagram.com/jmj_dotnetdev/" taget="_blank"><i class="fab fa-instagram"></i></a></li>
                                    <li><a href="mailto:jerrymckeejr.dev@gmail.com" taget="_blank"><i class="far fa-envelope"></i></a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- End Author Area  -->
